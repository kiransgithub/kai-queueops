# mock (safe local preview) or kubernetes
KAI_DATA_MODE=mock

# Optional runtime JSON file for branding, links, feature visibility, and refresh behavior.
APP_CONFIG_FILE=./config/ui.config.json

# Used when KAI_DATA_MODE=kubernetes. Omit for in-cluster ServiceAccount auth.
# KUBECONFIG=C:\Users\you\.kube\config

# Local PostgreSQL container settings. Replace the password before first use.
POSTGRES_USER=kai_admin
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=kai_admin

# Required for durable, append-only audit storage.
DATABASE_URL=postgresql://kai_admin:change-me-before-use@127.0.0.1:5432/kai_admin

# Optional Prometheus base URL for historical queue metrics.
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc:9090

# Only enable when deployed behind a trusted identity-aware reverse proxy.
TRUSTED_AUTH_PROXY=false
TRUSTED_AUTH_HEADER=x-auth-request-user
TRUSTED_DISPLAY_NAME_HEADER=x-auth-request-name
TRUSTED_ROLE_HEADER=x-auth-request-role

# Protects non-idempotent API calls. Generate a long random value in production.
API_MUTATION_TOKEN=change-me-in-production
